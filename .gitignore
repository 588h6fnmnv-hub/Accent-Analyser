# pyenv
#   For a library or package, you might want to ignore these files since the project is
#   environment-agnostic.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   with no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Using Poetry, it is generally recommended to commit poetry.lock to version control.
#   However, in case of a library, you might want to ignore poetry.lock.
#poetry.lock

# pdm
#   Using PDM, it is generally recommended to commit pdm.lock to version control.
#pdm.lock

# virtualenv
.venv/
venv/
ENV/
env/

# Spyder project settings
.spyderproject
.spyproject

# VS Code settings
.vscode/

# Ruff / Linters
.ruff_cache/
